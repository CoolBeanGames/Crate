class Mover : Actor3D
{
	float speed = 20.0;
	var elapsed = 0;

	func start()
	{
		print("Mover ready on " + actor.name);
	}

	func update(float delta)
	{
		elapsed = elapsed + delta;
		var r = transform.rotation;
		r.y = r.y + speed * delta;
		transform.rotation = r;
	}

	func physics_update(float delta)
	{
		//nothing
	}
}
