# Normalize line endings for source; leave vendored code and binaries alone.
* text=auto eol=lf
*.png binary
*.jpg binary
*.JPG binary
*.bmp binary
*.fbx binary
third_party/** -text
*.ps1 text eol=crlf
*.cscript text eol=lf
# Zen owns this file and rewrites it (CRLF, no trailing newline). Disable all
# git eol normalization for it so it doesn't show as perpetually modified.
zen.tasks.json -text
