# Normalize line endings for source; leave vendored code and binaries alone.
* text=auto eol=lf
*.png binary
*.jpg binary
*.JPG binary
*.bmp binary
*.fbx binary
third_party/** -text
*.ps1 text eol=crlf
# Zen rewrites this with CRLF; keep it so it doesn't show as perpetually modified.
zen.tasks.json text eol=crlf
